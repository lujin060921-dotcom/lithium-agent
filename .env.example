# 复制本文件为 .env，填入真实 Key。.env 已被 .gitignore 排除，不会进入源码提交。
# 未配置 Key 时，系统自动运行「离线确定性模式」，仍可完整跑通全流程。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可复现参数（固定值，不要随意改动，否则同输入重跑输出可能不一致）
LLM_TEMPERATURE=0
LLM_SEED=42

# 强制离线模式（不调用模型，输出确定性报告）：设为 true 生效
# AGENT_OFFLINE=true

# 模型调用超时与最大输出（max_tokens 过小会导致报告被截断）
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8000